# 构建产物（Maven / 前端）
target/
dist/
*.class

# 依赖
node_modules/
# Maven 沙箱本地仓库（工作区内临时仓库，不入库）
.m2-sandbox/
# pnpm 本地存储与临时目录（不入库）
.pnpm-store/
.tmp/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
.factorypath

# 操作系统
Thumbs.db
.DS_Store

# 日志
*.log
logs/
# 例外：Change 证据留档日志需要入库（changes 与 archive 归档目录均覆盖）
!delivery/changes/**/evidence/logs/
!delivery/changes/**/evidence/logs/**
!delivery/archive/**/evidence/logs/
!delivery/archive/**/evidence/logs/**
# 保留物化到工作仓的 Repository Delivery Evidence 日志
!delivery/CHG-*/**/evidence/logs/
!delivery/CHG-*/**/evidence/logs/**

# OpenSpec 每次 workflow run 生成的临时上下文
delivery/changes/**/.instruction.md
delivery/archive/**/.instruction.md

# 本地环境配置（不入库）
*.local

# 实现区：后端等代码仓库独立管理，工作区不追踪
implementation/
